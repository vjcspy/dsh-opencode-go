# Nested: fixture workspaces pin mutually exclusive host generations; hoisting
# breaks tests/hosts/*/node_modules deep imports (artifact.client.spec.ts).
# legacy-peer-deps: the tree spans 3 incompatible generations BY DESIGN
# (v017 alpha.1 vs root rc.1 devDeps vs v017-rc2); strict resolution fails in
# sequence: cordis 4.0.3 vs ~4.0.4, schemastery 3.18.3 vs ~3.18.4,
# settings-controller alpha.1 vs rc.1 peers. Pins stay exact; the flag only
# skips peer validation. Upstream 8590c57 has no .npmrc (root devDeps are
# single-generation there).
install-strategy=nested
legacy-peer-deps=true
